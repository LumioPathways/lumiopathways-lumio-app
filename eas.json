{
  "cli": { "version": ">= 12.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "NPM_CONFIG_LEGACY_PEER_DEPS": "true" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": { "NPM_CONFIG_LEGACY_PEER_DEPS": "true" },
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "NPM_CONFIG_LEGACY_PEER_DEPS": "true" },
      "ios": { "credentialsSource": "remote" },
      "android": { "credentialsSource": "remote", "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "winifred@lumiopathways.co.uk",
        "ascAppId": "PLACEHOLDER_APP_STORE_ID",
        "appleTeamId": "SH835JTR82"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "production"
      }
    }
  }
}
